  completedByUser User? @relation("InYardBookingCompletedBy", fields: [completedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([containerVisitId, status])
  @@index([bookingType])
  @@index([status])
  @@index([scheduledAt])
  @@map("in_yard_booking")
