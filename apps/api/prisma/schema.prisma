// ============================================================
// ICD Management System
// Database Foundation
//
// Database: MySQL 8.x
// Engine: InnoDB
// ORM: Prisma 7
//
// Quy ước:
// - UUID logic lưu CHAR(36).
// - Database naming dùng snake_case.
// - Prisma naming dùng camelCase / PascalCase.
// - Timestamp dùng DATETIME(3), lưu UTC.
// ============================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum ManifestStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum ContainerType {
  DRY
  REEFER
  FLATRACK
  OPENTOP
  TANK
}

enum ContainerSize {
  SIZE_20
  SIZE_40
  SIZE_45
}

enum ContainerVisitStatus {
  PENDING
  AUTHORIZED
  IN_YARD
  IN_TRANSIT
  ARRIVED
  INSPECTED
  GATE_IN_REQUESTED
  GATE_IN_CONFIRMED
  STACKED
  UNDER_CUSTOMS_HOLD
  CUSTOMS_CLEARED
  GATE_PASS_ISSUED
  GATE_OUT_CONFIRMED
  EXITED
  CANCELLED
}

enum ContainerCategory {
  IMPORT
  EXPORT
  STORAGE
}

enum ContainerHoldStatus {
  NONE
  CUSTOMS_HOLD
  ICD_HOLD
  PAYMENT_HOLD
}

enum MovementOrderStatus {
  DRAFT
  AUTHORIZED
  EXPIRED
  CANCELLED
}

enum TruckVisitType {
  GATE_IN
  GATE_OUT
}

enum TruckVisitStatus {
  SCHEDULED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum YardLocationSource {
  MANUAL
  RULE
  ML
  MOVEMENT
}

enum YardMovementStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContainerInspectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContainerInspectionResult {
  PASS
  FAIL
  HOLD
}

enum InYardBookingType {
  STRIPPING
  STUFFING
  INSPECTION
}

enum InYardBookingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TariffStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ServiceOrderStatus {
  DRAFT
  CONFIRMED
  INVOICED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum OperationalHoldType {
  CUSTOMS
  SHIPPING_LINE
  DAMAGE
  SECURITY
  DOCUMENT
  OTHER
}

enum OperationalHoldStatus {
  ACTIVE
  RELEASED
}

enum GatePassStatus {
  ACTIVE
  EXPIRED
  USED
  CANCELLED
}

enum EdiTransport {
  MOCK
  HTTPS
  SFTP
}

enum EdiOutboundFormat {
  CODECO_CANONICAL_JSON_V1
}

enum EdiMessageType {
  CODECO_GATE_IN
  CODECO_GATE_OUT
  COREOR
}

enum EdiOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD
}

enum EdiAcknowledgementType {
  CONTRL
  APERAK
}

enum EdiAcknowledgementStatus {
  ACCEPTED
  REJECTED
  ERROR
  UNMATCHED
}

enum EdiAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum EdiAlertSeverity {
  WARNING
  ERROR
  CRITICAL
}

enum EdiAlertSourceType {
  OUTBOX
  ACKNOWLEDGEMENT
}

enum EdiAlertType {
  DELIVERY_FAILURE
  ACK_REJECTED
  ACK_ERROR
  ACK_UNMATCHED
}

// ============================================================
// ICD SITE
// ============================================================

model IcdSite {
  id   String @id @default(uuid()) @db.Char(36)
  code String @unique @db.VarChar(50)
  name String @db.VarChar(150)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  users           User[]
  settings        IcdSetting[]
  manifests       Manifest[]
  containerVisits ContainerVisit[]
  truckVisits     TruckVisit[]
  yardBlocks      YardBlock[]
  tariffs         Tariff[]
  serviceOrders   ServiceOrder[]
  auditLogs       AuditLog[]
  ediRoutes       EdiRoute[]
  ediAlerts       EdiAlert[]

  @@map("icd_site")
}

// ============================================================
// USER
// ============================================================

model User {
  id String @id @default(uuid()) @db.Char(36)

  icdId String @map("icd_id") @db.Char(36)

  name  String @db.VarChar(150)
  email String @unique @db.VarChar(191)

  passwordHash String @map("password_hash") @db.VarChar(255)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  icd IcdSite @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  roles                       UserRole[]
  sessions                    AuthSession[]
  updatedSettings             IcdSetting[]           @relation("IcdSettingUpdatedBy")
  createdManifests            Manifest[]
  containerEvents             ContainerEvent[]
  createdMovementOrders       MovementOrder[]        @relation("MovementOrderCreatedBy")
  authorizedMovementOrders    MovementOrder[]        @relation("MovementOrderAuthorizedBy")
  receivedContainerReceptions ContainerReception[]   @relation("ContainerReceptionReceivedBy")
  assignedYardLocations       ContainerLocationLog[] @relation("ContainerLocationAssignedBy")
  createdYardMovements        YardMovement[]         @relation("YardMovementCreatedBy")
  completedYardMovements      YardMovement[]         @relation("YardMovementCompletedBy")
  createdInspections          ContainerInspection[]  @relation("ContainerInspectionCreatedBy")
  completedInspections        ContainerInspection[]  @relation("ContainerInspectionCompletedBy")
  createdYardBookings         InYardBooking[]        @relation("InYardBookingCreatedBy")
  completedYardBookings       InYardBooking[]        @relation("InYardBookingCompletedBy")
  createdTariffs              Tariff[]               @relation("TariffCreatedBy")
  createdServiceOrders        ServiceOrder[]         @relation("ServiceOrderCreatedBy")
  confirmedServiceOrders      ServiceOrder[]         @relation("ServiceOrderConfirmedBy")
  cancelledServiceOrders      ServiceOrder[]         @relation("ServiceOrderCancelledBy")
  recordedPayments            Payment[]              @relation("PaymentRecordedBy")
  placedOperationalHolds      OperationalHold[]      @relation("OperationalHoldPlacedBy")
  releasedOperationalHolds    OperationalHold[]      @relation("OperationalHoldReleasedBy")
  issuedGatePasses            GatePass[]             @relation("GatePassIssuedBy")
  auditLogs                   AuditLog[]             @relation("AuditLogActor")
  acknowledgedEdiAlerts       EdiAlert[]             @relation("EdiAlertAcknowledgedBy")
  resolvedEdiAlerts           EdiAlert[]             @relation("EdiAlertResolvedBy")

  @@index([icdId])
  @@index([active])
  @@map("user")
}

// ============================================================
// AUTH SESSION
//
// Mỗi lần đăng nhập tạo một session.
//
// Không lưu Refresh Token plaintext.
// Database chỉ lưu SHA-256 hash của token.
// ============================================================

model AuthSession {
  id String @id @default(uuid()) @db.Char(36)

  userId String @map("user_id") @db.Char(36)

  refreshTokenHash String @map("refresh_token_hash") @db.Char(64)

  expiresAt DateTime @map("expires_at") @db.DateTime(3)

  lastUsedAt DateTime? @map("last_used_at") @db.DateTime(3)

  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_session")
}

// ============================================================
// ROLE
// ============================================================

model Role {
  id String @id @default(uuid()) @db.Char(36)

  code String @unique @db.VarChar(50)
  name String @db.VarChar(100)

  description String? @db.VarChar(255)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

// ============================================================
// PERMISSION
// ============================================================

model Permission {
  id String @id @default(uuid()) @db.Char(36)

  code String @unique @db.VarChar(100)
  name String @db.VarChar(150)

  description String? @db.VarChar(255)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  roles RolePermission[]

  @@map("permission")
}

// ============================================================
// USER ↔ ROLE
// ============================================================

model UserRole {
  userId String @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// ============================================================
// ROLE ↔ PERMISSION
// ============================================================

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ============================================================
// ICD SETTING
// ============================================================

model IcdSetting {
  id String @id @default(uuid()) @db.Char(36)

  icdId String @map("icd_id") @db.Char(36)

  key   String @db.VarChar(100)
  value String @db.Text

  /**
   * Chưa ép enum vì đặc tả hiện tại mới định nghĩa
   * field value_type nhưng chưa chốt danh sách type.
   * Business layer sẽ validate khi module Settings
   * được triển khai.
   */
  valueType String @map("value_type") @db.VarChar(30)

  description String? @db.VarChar(255)

  updatedBy String? @map("updated_by") @db.Char(36)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  icd IcdSite @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  updatedByUser User? @relation("IcdSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([icdId, key])
  @@index([updatedBy])
  @@map("icd_setting")
}

// ============================================================
// SHIPPING LINE
//
// Global master catalog.
// Không scope theo ICD Site.
// ============================================================

model ShippingLine {
  id String @id @default(uuid()) @db.Char(36)

  name String @db.VarChar(150)

  scacCode String @unique @map("scac_code") @db.VarChar(10)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  manifests           Manifest[]
  masterBls           MasterBl[]
  ediRoutes           EdiRoute[]
  ediOutboxMessages   EdiOutboxMessage[]
  ediAcknowledgements EdiAcknowledgement[]

  @@index([active])
  @@index([name])
  @@map("shipping_line")
}

// ============================================================
// CONSIGNEE
// ============================================================

model Consignee {
  id String @id @default(uuid()) @db.Char(36)

  name String @db.VarChar(150)

  taxCode String @unique @map("tax_code") @db.VarChar(50)

  phone String? @db.VarChar(30)

  email String? @db.VarChar(191)

  address String? @db.VarChar(500)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  houseBls      HouseBl[]
  serviceOrders ServiceOrder[]
  payments      Payment[]

  @@index([active])
  @@index([name])
  @@map("consignee")
}

// ============================================================
// CLEARING AGENT
// ============================================================

model ClearingAgent {
  id String @id @default(uuid()) @db.Char(36)

  name String @db.VarChar(150)

  licenseNo String @unique @map("license_no") @db.VarChar(100)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  houseBls HouseBl[]

  @@index([active])
  @@index([name])
  @@map("clearing_agent")
}

// ============================================================
// TRANSPORTER
// ============================================================

model Transporter {
  id String @id @default(uuid()) @db.Char(36)

  name String @db.VarChar(150)

  taxCode String @unique @map("tax_code") @db.VarChar(50)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  truckVisits TruckVisit[]

  @@index([active])
  @@index([name])
  @@map("transporter")
}

// ============================================================
// MANIFEST
// ============================================================

model Manifest {
  id String @id @default(uuid()) @db.Char(36)

  icdId String @map("icd_id") @db.Char(36)

  manifestNo String @map("manifest_no") @db.VarChar(50)

  shippingLineId String @map("shipping_line_id") @db.Char(36)

  vesselName String @map("vessel_name") @db.VarChar(150)

  voyageNo String @map("voyage_no") @db.VarChar(100)

  eta DateTime @db.DateTime(3)

  portOfLoading String @map("port_of_loading") @db.VarChar(100)

  portOfDischarge String @map("port_of_discharge") @db.VarChar(100)

  status ManifestStatus @default(DRAFT)

  createdById String @map("created_by") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  icd IcdSite @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  shippingLine ShippingLine @relation(fields: [shippingLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdByUser User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  masterBls MasterBl[]

  @@unique([icdId, manifestNo])
  @@index([icdId, status])
  @@index([shippingLineId])
  @@index([eta])
  @@map("manifest")
}

// ============================================================
// MASTER B/L
// ============================================================

model MasterBl {
  id String @id @default(uuid()) @db.Char(36)

  manifestId String @map("manifest_id") @db.Char(36)

  mblNumber String @map("mbl_number") @db.VarChar(100)

  shippingLineId String @map("shipping_line_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  manifest Manifest @relation(fields: [manifestId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  shippingLine ShippingLine @relation(fields: [shippingLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  houseBls HouseBl[]

  @@unique([manifestId, mblNumber])
  @@index([shippingLineId])
  @@map("master_bl")
}

// ============================================================
// HOUSE B/L
// ============================================================

model HouseBl {
  id String @id @default(uuid()) @db.Char(36)

  masterBlId String @map("master_bl_id") @db.Char(36)

  hblNumber String @map("hbl_number") @db.VarChar(100)

  consigneeId String @map("consignee_id") @db.Char(36)

  clearingAgentId String @map("clearing_agent_id") @db.Char(36)

  cargoDescription String @map("cargo_description") @db.Text

  grossWeight Decimal @map("gross_weight") @db.Decimal(14, 3)

  packageCount Int @map("package_count")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  masterBl MasterBl @relation(fields: [masterBlId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  consignee Consignee @relation(fields: [consigneeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  clearingAgent ClearingAgent @relation(fields: [clearingAgentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  containerVisits ContainerVisit[]

  @@unique([masterBlId, hblNumber])
  @@index([consigneeId])
  @@index([clearingAgentId])
  @@map("house_bl")
}

// ============================================================
// CONTAINER (Physical asset)
// ============================================================

model Container {
  id String @id @default(uuid()) @db.Char(36)

  containerNumber String @unique @map("container_number") @db.VarChar(11)

  isoCode String @map("iso_code") @db.VarChar(10)

  size ContainerSize
  type ContainerType

  height     Decimal? @db.Decimal(5, 2)
  tareWeight Decimal? @map("tare_weight") @db.Decimal(10, 3)
  maxPayload Decimal? @map("max_payload") @db.Decimal(10, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  visits ContainerVisit[]

  @@index([containerNumber])
  @@map("container")
}

// ============================================================
// CONTAINER VISIT (ICD Lifecycle instance)
// ============================================================

model ContainerVisit {
  id String @id @default(uuid()) @db.Char(36)

  icdId String @map("icd_id") @db.Char(36)

  containerId String @map("container_id") @db.Char(36)

  houseBlId String? @map("house_bl_id") @db.Char(36)

  sealNumber String? @map("seal_number") @db.VarChar(50)

  cargoDescription String? @map("cargo_description") @db.Text

  grossWeight Decimal? @map("gross_weight") @db.Decimal(14, 3)

  status ContainerVisitStatus @default(PENDING)

  category ContainerCategory @default(IMPORT)

  holdStatus ContainerHoldStatus @default(NONE) @map("hold_status")

  isOverstay Boolean @default(false) @map("is_overstay")

  dwellDays Int @default(0) @map("dwell_days")

  currentLocation String? @map("current_location") @db.VarChar(100)

  gateInAt  DateTime? @map("gate_in_at") @db.DateTime(3)
  gateOutAt DateTime? @map("gate_out_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  icd       IcdSite   @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  container Container @relation(fields: [containerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  houseBl   HouseBl?  @relation(fields: [houseBlId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  events            ContainerEvent[]
  movementOrders    MovementOrder[]
  truckVisitLinks   TruckVisitContainer[]
  reception         ContainerReception?
  locationLogs      ContainerLocationLog[]
  yardMovements     YardMovement[]
  inspections       ContainerInspection[]
  inYardBookings    InYardBooking[]
  serviceOrders     ServiceOrder[]
  operationalHolds  OperationalHold[]
  gatePasses        GatePass[]
  ediOutboxMessages EdiOutboxMessage[]

  @@index([icdId, status])
  @@index([containerId])
  @@index([houseBlId])
  @@index([category])
  @@index([holdStatus])
  @@map("container_visit")
}

// ============================================================
// CONTAINER EVENT (Timeline log)
// ============================================================

model ContainerEvent {
  id String @id @default(uuid()) @db.Char(36)

  visitId String @map("visit_id") @db.Char(36)

  eventType String @map("event_type") @db.VarChar(100)

  fromStatus ContainerVisitStatus? @map("from_status")
  toStatus   ContainerVisitStatus? @map("to_status")

  actorId String? @map("actor_id") @db.Char(36)

  metadata Json?

  note String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  visit ContainerVisit @relation(fields: [visitId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor User?          @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([visitId])
  @@index([actorId])
  @@index([eventType])
  @@map("container_event")
}

// ============================================================
// MOVEMENT ORDER
// ============================================================

model MovementOrder {
  id String @id @default(uuid()) @db.Char(36)

  containerVisitId String @map("container_visit_id") @db.Char(36)

  status MovementOrderStatus @default(DRAFT)

  authorizedById String? @map("authorized_by") @db.Char(36)

  authorizedAt DateTime? @map("authorized_at") @db.DateTime(3)

  expiresAt DateTime? @map("expires_at") @db.DateTime(3)

  createdById String @map("created_by") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  containerVisit ContainerVisit @relation(fields: [containerVisitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdByUser User @relation("MovementOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  authorizedByUser User? @relation("MovementOrderAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([containerVisitId, status])
  @@index([status, expiresAt])
  @@index([createdById])
  @@index([authorizedById])
  @@map("movement_order")
}

// ============================================================
// TRUCK VISIT
// ============================================================

model TruckVisit {
  id String @id @default(uuid()) @db.Char(36)

  icdId String @map("icd_id") @db.Char(36)

  visitCode String @unique @map("visit_code") @db.VarChar(120)

  visitType TruckVisitType @map("visit_type")

  status TruckVisitStatus @default(SCHEDULED)

  appointmentAt DateTime? @map("appointment_at") @db.DateTime(3)

  arrivedAt DateTime? @map("arrived_at") @db.DateTime(3)

  completedAt DateTime? @map("completed_at") @db.DateTime(3)

  vehiclePlate String @map("vehicle_plate") @db.VarChar(50)

  trailerPlate String? @map("trailer_plate") @db.VarChar(50)

  driverName String @map("driver_name") @db.VarChar(200)

  driverPhone String? @map("driver_phone") @db.VarChar(50)

  transporterId String? @map("transporter_id") @db.Char(36)

  gateLane String? @map("gate_lane") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  icd IcdSite @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  transporter Transporter? @relation(fields: [transporterId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  containers TruckVisitContainer[]
  receptions ContainerReception[]

  @@index([icdId, status, appointmentAt])
  @@index([transporterId])
  @@index([vehiclePlate])
  @@map("truck_visit")
}

// ============================================================
// TRUCK VISIT CONTAINER
// ============================================================

model TruckVisitContainer {
  id String @id @default(uuid()) @db.Char(36)

  truckVisitId String @map("truck_visit_id") @db.Char(36)

  containerVisitId String @map("container_visit_id") @db.Char(36)

  sequenceNo Int? @map("sequence_no")

  truckVisit TruckVisit @relation(fields: [truckVisitId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  containerVisit ContainerVisit @relation(fields: [containerVisitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([truckVisitId, containerVisitId])
  @@index([containerVisitId])
  @@map("truck_visit_container")
}

// ============================================================
// CONTAINER RECEPTION
//
// Bằng chứng nghiệp vụ của một lần Gate-in thành công.
//
// Một Container Visit chỉ được có tối đa một Reception.
// Reception không bị update/xóa thông thường vì đây là
// dữ liệu lịch sử tại thời điểm container vào ICD.
// ============================================================

model ContainerReception {
  id String @id @default(uuid()) @db.Char(36)

  containerVisitId String @unique @map("container_visit_id") @db.Char(36)

  truckVisitId String? @map("truck_visit_id") @db.Char(36)

  actualSeal String @map("actual_seal") @db.VarChar(100)

  actualWeight Decimal? @map("actual_weight") @db.Decimal(14, 3)

  conditionCode String? @map("condition_code") @db.VarChar(80)

  conditionNotes String? @map("condition_notes") @db.Text

  /**
   * Reference tới ảnh đã upload.
   * Batch này chưa xây object-storage/upload service.
   * photo_ref chỉ lưu reference/path do upload layer cung cấp.
   */
  photoRef String? @map("photo_ref") @db.Text

  receivedById String @map("received_by") @db.Char(36)

  receivedAt DateTime @default(now()) @map("received_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  containerVisit ContainerVisit @relation(fields: [containerVisitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  truckVisit TruckVisit? @relation(fields: [truckVisitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  receivedByUser User @relation("ContainerReceptionReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([truckVisitId])
  @@index([receivedById])
  @@index([receivedAt])
  @@map("container_reception")
}

// ============================================================
// YARD BLOCK
// ============================================================

model YardBlock {
  id String @id @default(uuid()) @db.Char(36)

  icdId String @map("icd_id") @db.Char(36)

  blockCode String @map("block_code") @db.VarChar(50)

  name String? @db.VarChar(160)

  operational Boolean @default(true)

  icd IcdSite @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  slots YardSlot[]

  @@unique([icdId, blockCode])
  @@index([icdId, operational])
  @@map("yard_block")
}

// ============================================================
// YARD SLOT
// ============================================================

model YardSlot {
  id String @id @default(uuid()) @db.Char(36)

  yardBlockId String @map("yard_block_id") @db.Char(36)

  rowNo String @map("row_no") @db.VarChar(20)

  bayNo String @map("bay_no") @db.VarChar(20)

  tierNo String @map("tier_no") @db.VarChar(20)

  slotCode String? @map("slot_code") @db.VarChar(100)

  supportedContainerType String? @map("supported_container_type") @db.VarChar(30)

  reeferPower Boolean @default(false) @map("reefer_power")

  maxWeight Decimal? @map("max_weight") @db.Decimal(14, 3)

  operational Boolean @default(true)

  yardBlock YardBlock @relation(fields: [yardBlockId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  locationLogs  ContainerLocationLog[]
  movementsFrom YardMovement[]         @relation("YardMovementFromSlot")
  movementsTo   YardMovement[]         @relation("YardMovementToSlot")

  @@unique([yardBlockId, rowNo, bayNo, tierNo])
  @@index([yardBlockId, operational])
  @@index([supportedContainerType])
  @@map("yard_slot")
}

// ============================================================
// CONTAINER LOCATION LOG
// ============================================================

model ContainerLocationLog {
  id String @id @default(uuid()) @db.Char(36)

  containerVisitId String @map("container_visit_id") @db.Char(36)

  yardSlotId String @map("yard_slot_id") @db.Char(36)

  startedAt DateTime @default(now()) @map("started_at") @db.DateTime(3)

  endedAt DateTime? @map("ended_at") @db.DateTime(3)

  assignedById String? @map("assigned_by") @db.Char(36)

  source YardLocationSource @default(MANUAL)

  /**
   * Batch ML sau này sẽ thêm FK tới
   * yard_recommendation.
   * Hiện giữ nullable technical reference
   * đúng database design.
   */
  recommendationId String? @map("recommendation_id") @db.Char(36)

  containerVisit ContainerVisit @relation(fields: [containerVisitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  yardSlot YardSlot @relation(fields: [yardSlotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assignedByUser User? @relation("ContainerLocationAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([containerVisitId, endedAt])
  @@index([yardSlotId, endedAt])
  @@index([startedAt])
  @@map("container_location_log")
}

// ============================================================
// YARD MOVEMENT
// ============================================================

model YardMovement {
  id String @id @default(uuid()) @db.Char(36)

  containerVisitId String @map("container_visit_id") @db.Char(36)

  fromSlotId String @map("from_slot_id") @db.Char(36)

  toSlotId String @map("to_slot_id") @db.Char(36)

  status YardMovementStatus @default(PENDING)

  reason String? @db.VarChar(255)

  startedAt DateTime? @map("started_at") @db.DateTime(3)

  completedAt DateTime? @map("completed_at") @db.DateTime(3)

  createdById String @map("created_by") @db.Char(36)

  completedById String? @map("completed_by") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  containerVisit ContainerVisit @relation(fields: [containerVisitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  fromSlot YardSlot @relation("YardMovementFromSlot", fields: [fromSlotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  toSlot YardSlot @relation("YardMovementToSlot", fields: [toSlotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdByUser User @relation("YardMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  completedByUser User? @relation("YardMovementCompletedBy", fields: [completedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([containerVisitId, status])
  @@index([fromSlotId])
  @@index([toSlotId])
  @@index([status])
  @@map("yard_movement")
}

// ============================================================
// CONTAINER INSPECTION
// ============================================================

model ContainerInspection {
  id String @id @default(uuid()) @db.Char(36)

  containerVisitId String @map("container_visit_id") @db.Char(36)

  inspectionType String @map("inspection_type") @db.VarChar(80)

  status ContainerInspectionStatus @default(PENDING)

  result ContainerInspectionResult?

  notes String? @db.Text

  startedAt DateTime? @map("started_at") @db.DateTime(3)

  completedAt DateTime? @map("completed_at") @db.DateTime(3)

  createdById String @map("created_by") @db.Char(36)

  completedById String? @map("completed_by") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  containerVisit ContainerVisit @relation(fields: [containerVisitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdByUser User @relation("ContainerInspectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  completedByUser User? @relation("ContainerInspectionCompletedBy", fields: [completedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([containerVisitId, status])
  @@index([inspectionType])
  @@index([status])
  @@index([result])
  @@map("container_inspection")
}

// ============================================================
// IN YARD BOOKING
// ============================================================

model InYardBooking {
