// ============================================================
// SERVICE TYPE
// ============================================================

model ServiceType {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(255)
  unit        String   @db.VarChar(30)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tariffRules       TariffRule[]
  serviceOrderItems ServiceOrderItem[]

  @@index([active])
  @@map("service_type")
}

// ============================================================
// TARIFF
// ============================================================

model Tariff {
  id            String       @id @default(uuid()) @db.Char(36)
  icdId         String       @map("icd_id") @db.Char(36)
  name          String       @db.VarChar(150)
  status        TariffStatus @default(DRAFT)
  effectiveFrom DateTime     @map("effective_from") @db.DateTime(3)
  effectiveTo   DateTime?    @map("effective_to") @db.DateTime(3)
  createdById   String       @map("created_by") @db.Char(36)
  createdAt     DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  icd           IcdSite        @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser User           @relation("TariffCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rules         TariffRule[]
  serviceOrders ServiceOrder[]

  @@index([icdId, status])
  @@index([effectiveFrom, effectiveTo])
  @@map("tariff")
}

// ============================================================
// TARIFF RULE
// ============================================================

model TariffRule {
  id            String         @id @default(uuid()) @db.Char(36)
  tariffId      String         @map("tariff_id") @db.Char(36)
  serviceTypeId String         @map("service_type_id") @db.Char(36)
  containerSize ContainerSize? @map("container_size")
  containerType ContainerType? @map("container_type")
  unitPrice     Decimal        @map("unit_price") @db.Decimal(14, 2)
  currency      String         @default("VND") @db.VarChar(10)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  tariff      Tariff             @relation(fields: [tariffId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  serviceType ServiceType        @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItems  ServiceOrderItem[]

  @@index([tariffId])
  @@index([serviceTypeId])
  @@map("tariff_rule")
}

// ============================================================
// SERVICE ORDER
// ============================================================

model ServiceOrder {
  id               String             @id @default(uuid()) @db.Char(36)
  icdId            String             @map("icd_id") @db.Char(36)
  orderNumber      String             @unique @map("order_number") @db.VarChar(50)
  containerVisitId String             @map("container_visit_id") @db.Char(36)
  consigneeId      String             @map("consignee_id") @db.Char(36)
  tariffId         String             @map("tariff_id") @db.Char(36)
  status           ServiceOrderStatus @default(DRAFT)
  subtotalAmount   Decimal            @map("subtotal_amount") @db.Decimal(14, 2)
  vatRate          Decimal            @default(0.10) @map("vat_rate") @db.Decimal(5, 4)
  vatAmount        Decimal            @map("vat_amount") @db.Decimal(14, 2)
  totalAmount      Decimal            @map("total_amount") @db.Decimal(14, 2)
  currency         String             @default("VND") @db.VarChar(10)
  asOfDate         DateTime           @map("as_of_date") @db.DateTime(3)
  notes            String?            @db.Text
  createdById      String             @map("created_by") @db.Char(36)
  confirmedById    String?            @map("confirmed_by") @db.Char(36)
  confirmedAt      DateTime?          @map("confirmed_at") @db.DateTime(3)
  cancelledById    String?            @map("cancelled_by") @db.Char(36)
  cancelledAt      DateTime?          @map("cancelled_at") @db.DateTime(3)
  cancelReason     String?            @map("cancel_reason") @db.Text
  createdAt        DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  icd             IcdSite            @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  containerVisit  ContainerVisit     @relation(fields: [containerVisitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  consignee       Consignee          @relation(fields: [consigneeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tariff          Tariff             @relation(fields: [tariffId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser   User               @relation("ServiceOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  confirmedByUser User?              @relation("ServiceOrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cancelledByUser User?              @relation("ServiceOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items           ServiceOrderItem[]
  invoice         Invoice?

  @@index([icdId, status])
  @@index([containerVisitId, status])
  @@index([consigneeId])
  @@index([tariffId])
  @@map("service_order")
}

// ============================================================
// SERVICE ORDER ITEM
// ============================================================

model ServiceOrderItem {
  id             String   @id @default(uuid()) @db.Char(36)
  serviceOrderId String   @map("service_order_id") @db.Char(36)
  serviceTypeId  String   @map("service_type_id") @db.Char(36)
  tariffRuleId   String?  @map("tariff_rule_id") @db.Char(36)
  sourceType     String   @map("source_type") @db.VarChar(50)
  sourceId       String?  @map("source_id") @db.Char(36)
  quantity       Decimal  @db.Decimal(12, 2)
  unit           String   @db.VarChar(30)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(14, 2)
  amount         Decimal  @db.Decimal(14, 2)
  description    String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  serviceType  ServiceType  @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tariffRule   TariffRule?  @relation(fields: [tariffRuleId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([serviceOrderId])
  @@index([serviceTypeId])
  @@index([tariffRuleId])
  @@index([sourceType, sourceId])
  @@map("service_order_item")
}

// ============================================================
// INVOICE
// ============================================================

model Invoice {
  id String @id @default(uuid()) @db.Char(36)

  serviceOrderId String        @unique @map("service_order_id") @db.Char(36)
  invoiceNo      String        @unique @map("invoice_no") @db.VarChar(120)
  issuedAt       DateTime      @default(now()) @map("issued_at") @db.DateTime(3)
  dueAt          DateTime?     @map("due_at") @db.DateTime(3)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(18, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(18, 2)
  status         InvoiceStatus @default(UNPAID)

  serviceOrder ServiceOrder        @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  allocations  PaymentAllocation[]

  @@index([status, dueAt])
  @@map("invoice")
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id String @id @default(uuid()) @db.Char(36)

  consigneeId  String        @map("consignee_id") @db.Char(36)
  paymentRef   String        @unique @map("payment_ref") @db.VarChar(120)
  amount       Decimal       @db.Decimal(18, 2)
  method       PaymentMethod
  paidAt       DateTime      @map("paid_at") @db.DateTime(3)
  recordedById String        @map("recorded_by") @db.Char(36)

  consignee      Consignee           @relation(fields: [consigneeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recordedByUser User                @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  allocations    PaymentAllocation[]

  @@index([consigneeId, paidAt])
  @@index([paidAt])
  @@map("payment")
}

// ============================================================
// PAYMENT ALLOCATION
// ============================================================

model PaymentAllocation {
  id String @id @default(uuid()) @db.Char(36)

  paymentId String   @map("payment_id") @db.Char(36)
  invoiceId String   @map("invoice_id") @db.Char(36)
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocation")
}

// ============================================================
// OPERATIONAL HOLD
// ============================================================

model OperationalHold {
  id String @id @default(uuid()) @db.Char(36)

  containerVisitId String                @map("container_visit_id") @db.Char(36)
  holdType         OperationalHoldType   @map("hold_type")
  status           OperationalHoldStatus @default(ACTIVE)
  reason           String                @db.Text
  placedById       String?               @map("placed_by") @db.Char(36)
  placedAt         DateTime              @default(now()) @map("placed_at") @db.DateTime(3)
  releasedById     String?               @map("released_by") @db.Char(36)
  releasedAt       DateTime?             @map("released_at") @db.DateTime(3)
  releaseReason    String?               @map("release_reason") @db.Text

  containerVisit ContainerVisit @relation(fields: [containerVisitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  placedByUser   User?          @relation("OperationalHoldPlacedBy", fields: [placedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  releasedByUser User?          @relation("OperationalHoldReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([containerVisitId, status])
  @@index([holdType, status])
  @@map("operational_hold")
}

// ============================================================
// GATE PASS
// ============================================================

model GatePass {
  id String @id @default(uuid()) @db.Char(36)

  containerVisitId String         @map("container_visit_id") @db.Char(36)
  code             String         @unique @db.VarChar(120)
  qrTokenHash      String         @unique @map("qr_token_hash") @db.Char(64)
  status           GatePassStatus @default(ACTIVE)
  issuedById       String         @map("issued_by") @db.Char(36)
  issuedAt         DateTime       @default(now()) @map("issued_at") @db.DateTime(3)
  expiresAt        DateTime       @map("expires_at") @db.DateTime(3)
  usedAt           DateTime?      @map("used_at") @db.DateTime(3)
  vehiclePlate     String?        @map("vehicle_plate") @db.VarChar(50)
  receiverName     String?        @map("receiver_name") @db.VarChar(200)
  receiverIdNumber String?        @map("receiver_id_number") @db.VarChar(100)

  containerVisit ContainerVisit @relation(fields: [containerVisitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  issuedByUser   User           @relation("GatePassIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([containerVisitId, status])
  @@index([expiresAt, status])
  @@map("gate_pass")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id String @id @default(uuid()) @db.Char(36)

  icdId String @map("icd_id") @db.Char(36)

  actorUserId String? @map("actor_user_id") @db.Char(36)

  action String @db.VarChar(80)

  entityType String @map("entity_type") @db.VarChar(80)

  entityId String @map("entity_id") @db.VarChar(120)

  oldDataJson Json? @map("old_data_json")

  newDataJson Json? @map("new_data_json")

  reason String? @db.Text

  requestId String @map("request_id") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  icd       IcdSite @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser User?   @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([icdId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([requestId])
  @@map("audit_log")
}

// ============================================================
// EDI ROUTE
// ============================================================

model EdiRoute {
  id String @id @default(uuid()) @db.Char(36)

  icdId String @map("icd_id") @db.Char(36)

  shippingLineId String @map("shipping_line_id") @db.Char(36)

  enabled Boolean @default(true)

  transport EdiTransport

  outboundFormat EdiOutboundFormat @default(CODECO_CANONICAL_JSON_V1) @map("outbound_format")

  /**
   * MOCK:
   * mock://local
   * HTTPS:
   * https://partner.example.com/edi/codeco
   * SFTP:
   * sftp://username@sftp.partner.com:22/inbound
   */
  partnerTarget String @map("partner_target") @db.Text

  /**
   * Chỉ lưu TÊN environment variable.
   * Không lưu secret thật.
   */
  credentialRef String? @map("credential_ref") @db.VarChar(160)

  /**
   * SFTP host-key fingerprint/pinning.
   */
  hostKeySha256 String? @map("host_key_sha256") @db.VarChar(160)

  timeoutMs Int @default(10000) @map("timeout_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  icd IcdSite @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  shippingLine ShippingLine @relation(fields: [shippingLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  outboxMessages EdiOutboxMessage[]

  @@unique([icdId, shippingLineId])
  @@index([enabled, transport])
  @@map("edi_route")
}

// ============================================================
// EDI OUTBOX MESSAGE
// ============================================================

model EdiOutboxMessage {
  id String @id @default(uuid()) @db.Char(36)

  ediRouteId String @map("edi_route_id") @db.Char(36)

  containerVisitId String? @map("container_visit_id") @db.Char(36)

  shippingLineId String @map("shipping_line_id") @db.Char(36)

  messageType EdiMessageType @map("message_type")

  status EdiOutboxStatus @default(PENDING)

  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(200)

  /**
   * Canonical message bất biến tại thời điểm
   * nghiệp vụ commit.
   */
  payloadSnapshot Json @map("payload_snapshot")

  /**
   * Route cũng bị freeze.
   * Retry không đọc route mới rồi đổi endpoint.
   */
  routingSnapshot Json @map("routing_snapshot")

  requestId String? @map("request_id") @db.VarChar(128)

  retryCount Int @default(0) @map("retry_count")

  nextRetryAt DateTime? @map("next_retry_at") @db.DateTime(3)

  processingStartedAt DateTime? @map("processing_started_at") @db.DateTime(3)

  lastAttemptAt DateTime? @map("last_attempt_at") @db.DateTime(3)

  externalReference String? @map("external_reference") @db.VarChar(255)

  lastError String? @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  sentAt DateTime? @map("sent_at") @db.DateTime(3)

  ediRoute EdiRoute @relation(fields: [ediRouteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  containerVisit ContainerVisit? @relation(fields: [containerVisitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  shippingLine ShippingLine @relation(fields: [shippingLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  acknowledgements EdiAcknowledgement[]

  @@index([status, nextRetryAt, createdAt])
  @@index([shippingLineId, createdAt])
  @@index([containerVisitId, createdAt])
  @@index([processingStartedAt])
  @@map("edi_outbox_message")
}

// ============================================================
// EDI ACKNOWLEDGEMENT (CONTRL / APERAK / Application receipts)
// ============================================================

model EdiAcknowledgement {
  id String @id @default(uuid()) @db.Char(36)

  outboxMessageId String? @map("outbox_message_id") @db.Char(36)

  shippingLineId String @map("shipping_line_id") @db.Char(36)

  ackType EdiAcknowledgementType @map("ack_type")

  status EdiAcknowledgementStatus

  externalReference String? @map("external_reference") @db.VarChar(255)

  /**
   * Raw CONTRL / APERAK hoặc raw JSON receipt.
   */
  rawPayload String? @map("raw_payload") @db.LongText

  /**
   * Parser-specific structure.
   * Không dùng làm source-of-truth cho lifecycle ICD.
   */
  parsedPayload Json? @map("parsed_payload")

  /**
   * Technical extension để webhook/SFTP polling
   * không ghi cùng receipt nhiều lần.
   */
  dedupeKey String @unique @map("dedupe_key") @db.Char(64)

  receivedAt DateTime @default(now()) @map("received_at") @db.DateTime(3)

  outboxMessage EdiOutboxMessage? @relation(fields: [outboxMessageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shippingLine  ShippingLine      @relation(fields: [shippingLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([outboxMessageId, receivedAt])
  @@index([shippingLineId, receivedAt])
  @@index([status, receivedAt])
  @@index([ackType, receivedAt])
  @@map("edi_acknowledgement")
}

// ============================================================
// EDI OPERATIONAL ALERT / INCIDENT
// ============================================================

model EdiAlert {
  id String @id @default(uuid()) @db.Char(36)

  icdId String @map("icd_id") @db.Char(36)

  sourceType EdiAlertSourceType @map("source_type")

  /**
   * ID của EdiOutboxMessage hoặc
   * EdiAcknowledgement.
   */
  sourceId String @map("source_id") @db.Char(36)

  alertType EdiAlertType @map("alert_type")

  severity EdiAlertSeverity

  status EdiAlertStatus @default(OPEN)

  title String @db.VarChar(200)

  message String @db.Text

  occurrenceCount Int @default(1) @map("occurrence_count")

  firstOccurredAt DateTime @default(now()) @map("first_occurred_at") @db.DateTime(3)

  lastOccurredAt DateTime @default(now()) @map("last_occurred_at") @db.DateTime(3)

  acknowledgedById String? @map("acknowledged_by") @db.Char(36)

  acknowledgedAt DateTime? @map("acknowledged_at") @db.DateTime(3)

  resolvedById String? @map("resolved_by") @db.Char(36)

  resolvedAt DateTime? @map("resolved_at") @db.DateTime(3)

  resolutionNote String? @map("resolution_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  icd                IcdSite @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acknowledgedByUser User?   @relation("EdiAlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resolvedByUser     User?   @relation("EdiAlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([sourceType, sourceId, alertType])
  @@index([icdId, status, severity])
  @@index([alertType, status])
  @@index([lastOccurredAt])
  @@map("edi_alert")
}
