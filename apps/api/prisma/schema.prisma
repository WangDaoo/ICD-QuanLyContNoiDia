// ============================================================
// ICD Management System
// Database Foundation
//
// Database: MySQL 8.x
// Engine: InnoDB
// ORM: Prisma 7
//
// Quy ước:
// - UUID logic lưu CHAR(36).
// - Database naming dùng snake_case.
// - Prisma naming dùng camelCase / PascalCase.
// - Timestamp dùng DATETIME(3), lưu UTC.
// ============================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum ManifestStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum ContainerType {
  DRY
  REEFER
  FLATRACK
  OPENTOP
  TANK
}

enum ContainerSize {
  SIZE_20
  SIZE_40
  SIZE_45
}

enum ContainerVisitStatus {
  PENDING
  AUTHORIZED
  IN_TRANSIT
  ARRIVED
  INSPECTED
  GATE_IN_REQUESTED
  GATE_IN_CONFIRMED
  STACKED
  UNDER_CUSTOMS_HOLD
  CUSTOMS_CLEARED
  GATE_PASS_ISSUED
  GATE_OUT_CONFIRMED
  EXITED
  CANCELLED
}

enum ContainerCategory {
  IMPORT
  EXPORT
  STORAGE
}

enum ContainerHoldStatus {
  NONE
  CUSTOMS_HOLD
  ICD_HOLD
  PAYMENT_HOLD
}

// ============================================================
// ICD SITE
// ============================================================

model IcdSite {
  id   String @id @default(uuid()) @db.Char(36)
  code String @unique @db.VarChar(50)
  name String @db.VarChar(150)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  users           User[]
  settings        IcdSetting[]
  manifests       Manifest[]
  containerVisits ContainerVisit[]

  @@map("icd_site")
}

// ============================================================
// USER
// ============================================================

model User {
  id String @id @default(uuid()) @db.Char(36)

  icdId String @map("icd_id") @db.Char(36)

  name  String @db.VarChar(150)
  email String @unique @db.VarChar(191)

  passwordHash String @map("password_hash") @db.VarChar(255)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  icd IcdSite @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  roles            UserRole[]
  sessions         AuthSession[]
  updatedSettings  IcdSetting[]     @relation("IcdSettingUpdatedBy")
  createdManifests Manifest[]
  containerEvents  ContainerEvent[]

  @@index([icdId])
  @@index([active])
  @@map("user")
}

// ============================================================
// AUTH SESSION
//
// Mỗi lần đăng nhập tạo một session.
//
// Không lưu Refresh Token plaintext.
// Database chỉ lưu SHA-256 hash của token.
// ============================================================

model AuthSession {
  id String @id @default(uuid()) @db.Char(36)

  userId String @map("user_id") @db.Char(36)

  refreshTokenHash String @map("refresh_token_hash") @db.Char(64)

  expiresAt DateTime @map("expires_at") @db.DateTime(3)

  lastUsedAt DateTime? @map("last_used_at") @db.DateTime(3)

  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_session")
}

// ============================================================
// ROLE
// ============================================================

model Role {
  id String @id @default(uuid()) @db.Char(36)

  code String @unique @db.VarChar(50)
  name String @db.VarChar(100)

  description String? @db.VarChar(255)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

// ============================================================
// PERMISSION
// ============================================================

model Permission {
  id String @id @default(uuid()) @db.Char(36)

  code String @unique @db.VarChar(100)
  name String @db.VarChar(150)

  description String? @db.VarChar(255)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  roles RolePermission[]

  @@map("permission")
}

// ============================================================
// USER ↔ ROLE
// ============================================================

model UserRole {
  userId String @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// ============================================================
// ROLE ↔ PERMISSION
// ============================================================

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ============================================================
// ICD SETTING
// ============================================================

model IcdSetting {
  id String @id @default(uuid()) @db.Char(36)

  icdId String @map("icd_id") @db.Char(36)

  key   String @db.VarChar(100)
  value String @db.Text

  /**
   * Chưa ép enum vì đặc tả hiện tại mới định nghĩa
   * field value_type nhưng chưa chốt danh sách type.
   * Business layer sẽ validate khi module Settings
   * được triển khai.
   */
  valueType String @map("value_type") @db.VarChar(30)

  description String? @db.VarChar(255)

  updatedBy String? @map("updated_by") @db.Char(36)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  icd IcdSite @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  updatedByUser User? @relation("IcdSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([icdId, key])
  @@index([updatedBy])
  @@map("icd_setting")
}

// ============================================================
// SHIPPING LINE
//
// Global master catalog.
// Không scope theo ICD Site.
// ============================================================

model ShippingLine {
  id String @id @default(uuid()) @db.Char(36)

  name String @db.VarChar(150)

  scacCode String @unique @map("scac_code") @db.VarChar(10)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  manifests Manifest[]
  masterBls MasterBl[]

  @@index([active])
  @@index([name])

  @@map("shipping_line")
}

// ============================================================
// CONSIGNEE
// ============================================================

model Consignee {
  id String @id @default(uuid()) @db.Char(36)

  name String @db.VarChar(150)

  taxCode String @unique @map("tax_code") @db.VarChar(50)

  phone String? @db.VarChar(30)

  email String? @db.VarChar(191)

  address String? @db.VarChar(500)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  houseBls HouseBl[]

  @@index([active])
  @@index([name])

  @@map("consignee")
}

// ============================================================
// CLEARING AGENT
// ============================================================

model ClearingAgent {
  id String @id @default(uuid()) @db.Char(36)

  name String @db.VarChar(150)

  licenseNo String @unique @map("license_no") @db.VarChar(100)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  houseBls HouseBl[]

  @@index([active])
  @@index([name])

  @@map("clearing_agent")
}

// ============================================================
// TRANSPORTER
// ============================================================

model Transporter {
  id String @id @default(uuid()) @db.Char(36)

  name String @db.VarChar(150)

  taxCode String @unique @map("tax_code") @db.VarChar(50)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([active])
  @@index([name])

  @@map("transporter")
}

// ============================================================
// MANIFEST
// ============================================================

model Manifest {
  id String @id @default(uuid()) @db.Char(36)

  icdId String @map("icd_id") @db.Char(36)

  manifestNo String @map("manifest_no") @db.VarChar(50)

  shippingLineId String @map("shipping_line_id") @db.Char(36)

  vesselName String @map("vessel_name") @db.VarChar(150)

  voyageNo String @map("voyage_no") @db.VarChar(100)

  eta DateTime @db.DateTime(3)

  portOfLoading String @map("port_of_loading") @db.VarChar(100)

  portOfDischarge String @map("port_of_discharge") @db.VarChar(100)

  status ManifestStatus @default(DRAFT)

  createdById String @map("created_by") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  icd IcdSite @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  shippingLine ShippingLine @relation(fields: [shippingLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdByUser User @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  masterBls MasterBl[]

  @@unique([icdId, manifestNo])

  @@index([icdId, status])
  @@index([shippingLineId])
  @@index([eta])

  @@map("manifest")
}

// ============================================================
// MASTER B/L
// ============================================================

model MasterBl {
  id String @id @default(uuid()) @db.Char(36)

  manifestId String @map("manifest_id") @db.Char(36)

  mblNumber String @map("mbl_number") @db.VarChar(100)

  shippingLineId String @map("shipping_line_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  manifest Manifest @relation(fields: [manifestId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  shippingLine ShippingLine @relation(fields: [shippingLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  houseBls HouseBl[]

  @@unique([manifestId, mblNumber])

  @@index([shippingLineId])

  @@map("master_bl")
}

// ============================================================
// HOUSE B/L
// ============================================================

model HouseBl {
  id String @id @default(uuid()) @db.Char(36)

  masterBlId String @map("master_bl_id") @db.Char(36)

  hblNumber String @map("hbl_number") @db.VarChar(100)

  consigneeId String @map("consignee_id") @db.Char(36)

  clearingAgentId String @map("clearing_agent_id") @db.Char(36)

  cargoDescription String @map("cargo_description") @db.Text

  grossWeight Decimal @map("gross_weight") @db.Decimal(14, 3)

  packageCount Int @map("package_count")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  masterBl MasterBl @relation(fields: [masterBlId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  consignee Consignee @relation(fields: [consigneeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  clearingAgent ClearingAgent @relation(fields: [clearingAgentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  containerVisits ContainerVisit[]

  @@unique([masterBlId, hblNumber])

  @@index([consigneeId])
  @@index([clearingAgentId])

  @@map("house_bl")
}

// ============================================================
// CONTAINER (Physical asset)
// ============================================================

model Container {
  id String @id @default(uuid()) @db.Char(36)

  containerNumber String @unique @map("container_number") @db.VarChar(11)

  isoCode String @map("iso_code") @db.VarChar(10)

  size ContainerSize
  type ContainerType

  height     Decimal? @db.Decimal(5, 2)
  tareWeight Decimal? @map("tare_weight") @db.Decimal(10, 3)
  maxPayload Decimal? @map("max_payload") @db.Decimal(10, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  visits ContainerVisit[]

  @@index([containerNumber])
  @@map("container")
}

// ============================================================
// CONTAINER VISIT (ICD Lifecycle instance)
// ============================================================

model ContainerVisit {
  id String @id @default(uuid()) @db.Char(36)

  icdId String @map("icd_id") @db.Char(36)

  containerId String @map("container_id") @db.Char(36)

  houseBlId String? @map("house_bl_id") @db.Char(36)

  sealNumber String? @map("seal_number") @db.VarChar(50)

  cargoDescription String? @map("cargo_description") @db.Text

  grossWeight Decimal? @map("gross_weight") @db.Decimal(14, 3)

  status ContainerVisitStatus @default(PENDING)

  category ContainerCategory @default(IMPORT)

  holdStatus ContainerHoldStatus @default(NONE) @map("hold_status")

  isOverstay Boolean @default(false) @map("is_overstay")

  dwellDays Int @default(0) @map("dwell_days")

  currentLocation String? @map("current_location") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  icd       IcdSite   @relation(fields: [icdId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  container Container @relation(fields: [containerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  houseBl   HouseBl?  @relation(fields: [houseBlId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  events ContainerEvent[]

  @@index([icdId, status])
  @@index([containerId])
  @@index([houseBlId])
  @@index([category])
  @@index([holdStatus])
  @@map("container_visit")
}

// ============================================================
// CONTAINER EVENT (Timeline log)
// ============================================================

model ContainerEvent {
  id String @id @default(uuid()) @db.Char(36)

  visitId String @map("visit_id") @db.Char(36)

  eventType String @map("event_type") @db.VarChar(100)

  fromStatus ContainerVisitStatus? @map("from_status")
  toStatus   ContainerVisitStatus? @map("to_status")

  actorId String? @map("actor_id") @db.Char(36)

  metadata Json?

  note String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  visit ContainerVisit @relation(fields: [visitId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor User?          @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([visitId])
  @@index([actorId])
  @@index([eventType])
  @@map("container_event")
}


