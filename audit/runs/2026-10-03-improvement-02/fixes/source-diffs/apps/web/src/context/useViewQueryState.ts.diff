--- before/apps/web/src/context/useViewQueryState.ts
+++ after/apps/web/src/context/useViewQueryState.ts
@@ -0,0 +1,31 @@
+import { createContext, useCallback, useContext, useEffect, useState } from 'react';
+import { useApp } from './AppContext';
+const safe = (value: string | null, fallback: string) => value !== null && value.length <= 128 && !Array.from(value).some(character => character.charCodeAt(0) < 32) ? value : fallback;
+export const ViewQueryContext = createContext<{ view: string; search: string; replaceSearch: (search: string) => void } | undefined>(undefined);
+export function useViewQueryState(view: string, key: string, initial: string): [string, (value: string) => void] {
+  const { currentUser } = useApp();
+  const environment = useContext(ViewQueryContext);
+  const search = environment?.search ?? '';
+  const active = environment?.view === view;
+  const storageKey = `icd:view:${currentUser.id}:${view}:${key}`;
+  const read = useCallback(() => {
+    if (active && new URLSearchParams(search).has(key)) return safe(new URLSearchParams(search).get(key), initial);
+    try { return safe(sessionStorage.getItem(storageKey), initial); } catch { return initial; }
+  }, [active, search, key, initial, storageKey]);
+  const [value, setValue] = useState(read);
+  useEffect(() => { if (active) setValue(read()); }, [active, read]);
+  const update = useCallback((next: string) => {
+    const valid = safe(next, initial);
+    setValue(valid);
+    try { sessionStorage.setItem(storageKey, valid); } catch { /* Navigation remains usable without storage. */ }
+    if (active) {
+      const params = new URLSearchParams(search);
+      if (valid === initial) params.delete(key); else params.set(key, valid);
+      environment?.replaceSearch(params.toString());
+    }
+  }, [active, initial, key, search, environment, storageKey]);
+  return [value, update];
+}
+export function clearViewState(userId: string): void {
+  try { for (const key of Object.keys(sessionStorage)) if (key.startsWith(`icd:view:${userId}:`)) sessionStorage.removeItem(key); } catch { /* Memory-only drafts are cleared by unmount. */ }
+}
